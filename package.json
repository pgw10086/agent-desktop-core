{
  "name": "@hermit/desktop-core",
  "version": "0.1.0",
  "packageManager": "pnpm@11.0.0",
  "description": "Hermit Desktop Core typed capabilities and Electron platform adapters",
  "repository": "https://github.com/pgw10086/desktop-core.git",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.0.0 <12"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./electron-notification-factory": {
      "types": "./lib/electron-notification-factory.d.ts",
      "default": "./lib/electron-notification-factory.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.js.map"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "corepack pnpm run clean && tsc -p tsconfig.json",
    "test": "corepack pnpm run build && node --test tests/*.test.mjs",
    "prepack": "corepack pnpm run build"
  },
  "license": "Apache-2.0",
  "peerDependencies": {
    "electron": ">=43.0.0 <44"
  },
  "devDependencies": {
    "@types/node": ">=24.0.0 <25",
    "electron": ">=43.0.0 <44",
    "typescript": ">=6.0.0 <7"
  }
}
