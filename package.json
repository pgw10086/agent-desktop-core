{
  "name": "agent-desktop-core-workspace",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "build": "corepack pnpm --recursive --if-present build",
    "test": "corepack pnpm --recursive --if-present test",
    "pack:core": "corepack pnpm --filter @hermit/agent-desktop-core pack",
    "pack:dsh": "corepack pnpm --filter @hermit/dsh-runtime-adapter pack"
  }
}
